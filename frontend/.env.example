# Snowflake connection for /api/layout and /api/events (server-side only — never NEXT_PUBLIC_*).
# Without these the API routes answer { disabled: true } and the store runs on its defaults.
# Service user + key: `python -m server app-user` creates ATELIER_APP; the private key file
# is hand-delivered, never committed.

SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=ATELIER_APP
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SNOWFLAKE_WAREHOUSE=ATELIER_WH
SNOWFLAKE_DATABASE=ATELIER
SNOWFLAKE_SCHEMA=LIVE
SNOWFLAKE_ROLE=ATELIER_APP_ROLE

# LLM provider for /api/llm-layout and /api/chat (server-side only).
# Pick ONE provider. Nebius Token Factory (OpenAI-compatible):
NEBIUS_API_KEY=
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# ...or Google AI Studio:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Force a provider when both keys exist (defaults to nebius):
# LLM_PROVIDER=nebius
