# Copy to .env (never commit .env). Values are in Supabase: Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Teammates: the anon/public key plus the login the project owner created for you.
SUPABASE_ANON_KEY=
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# Uploader only. Bypasses all access rules: never share it, never use it in a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Kaggle, for python -m session_model (OTTO download): kaggle.com -> Settings -> API -> Create New Token,
# then copy "username" and "key" from the downloaded kaggle.json. Or one newer-style token: KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
